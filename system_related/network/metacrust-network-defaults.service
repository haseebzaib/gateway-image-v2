[Unit]
Description=Bring up MetaCrust default network substrate
After=systemd-networkd.service
Wants=systemd-networkd.service systemd-resolved.service ModemManager.service

[Service]
Type=oneshot
ExecStart=/opt/metacrust/scripts/metacrust-network-defaults.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=MetaCrust C++ gateway core
After=metacrust-layout.service metacrust-hub.service network-online.target
Wants=metacrust-layout.service metacrust-hub.service network-online.target
ConditionFileIsExecutable=/opt/metacrust/gateway_core/gateway-core

[Service]
Type=simple
ExecStart=/opt/metacrust/gateway_core/gateway-core
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=MetaCrust standalone Tailscale bootstrap
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/metacrust/secrets/tailscale.env
ExecStart=/opt/metacrust/bin/metacrust-tailscale-bootstrap.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
